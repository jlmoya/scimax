mode(-1);
lines(0);
here=get_absolute_file_path('SciMax.start');
mpath=strsubst(here','\','/')+'/../'

setenv('SCIMAX_TOOLBOX_PATH',mpath)

// The Overload Toolbox is absent and CANNOT be installed here. This is not a
// packaging gap: its src/overstack.c drives Scilab 5's interpreter through
// C2F(cvname), C2F(cvnamel) and C2F(createvarfromptr) — Fortran-bridge entry
// points into the old symbol table, which Scilab 6 deleted when the interpreter
// was rewritten around a C++ AST. Rebuilding it is not the issue; it needs
// redesigning against native %<type>_<function> overloading.
//
// CORRECTION 2026-07-31: the previous note here claimed "SciMax's own overloads
// do not need it". That is only true of the sym-type OPERATOR overloads
// (newfun on maxadd/maxpow/...) further down. macros/maxfun/personnalizedOverload.sce
// DOES need overload(), and once genmaxfun was built the load reached it and
// aborted SciMax before its own macro libraries were registered. See the guard
// at the genmaxfun block below.
exec(here+'Overload_TB_path.sce',-1)
if fileinfo(Overload_TB_path)==[] then
  printf('Overload Toolbox not found (Scilab-5-only; see etc/SciMax.start). SciMax''s sym-type operator overloads are unaffected.\n')
else
  exec(Overload_TB_path,-1)
end

exec(here+'MAXIMA_EXE_PATH.sce',-1)
if fileinfo(%maxima_exe_path)==[] then
  printf('You need to set the full name of maxima execution in file ./etc/MAXIMA_EXE_PATH.sce\n')
  clear  MAXIMA_EXE_PATH
  abort
else
  setenv('MAXIMA_EXE_PATH',%maxima_exe_path)  
end


printf('\nLoading Maxima library : ')

// macOS/2027 port (Task 12): the original registered these last 19 slots
// under friendly aliases ('maxadd'..'maxaff', matching src/c/maxsci-level
// naming) rather than the build-time table names src/c/builder_c.sce
// actually compiled them under ('maxevalopA'..'maxevalopS', all pointing at
// the same C function sci_maxevalop -- see maxevalop.c's determineOp(),
// which reads the INVOKED name's 10th character to tell the 19 operators
// apart). That worked under the old addinter/funptr, which resolved by
// build-time table POSITION; confirmed by isolated reproduction that this
// build's addinter no longer binds repeated-C-function name aliases that
// way (exists('maxadd') stayed false after addinter even though the call
// "succeeded"; exists('maxevalopA'..'S') all resolve). Register under the
// literal build-time names instead, and alias from THOSE below.
functions=['maxinit';'maxkill';'maxevalf';'maxevalfl';'%sym_p';'sym';'Matrix';'symnp';'defmf';'Syms';'latex';'mathml';'answer';'noanswer';'maxevalopA';'maxevalopB';'maxevalopC';'maxevalopD';'maxevalopE';'maxevalopF';'maxevalopG';'maxevalopH';'maxevalopI';'maxevalopJ';'maxevalopK';'maxevalopL';'maxevalopM';'maxevalopN';'maxevalopO';'maxevalopP';'maxevalopQ';'maxevalopR';'maxevalopS']

if or(link()=='libmaxima') then
  printf('The file libmaxima is already loaded. Try to unload it with ulink.\n');
  abort
end

if getos() == 'Windows' then
 LIBPATHNAME = mpath+'src/c/maxima' + getdynlibext();
 ENTRYLIB = 'maxima';
else
 LIBPATHNAME = mpath+'src/c/libmaxima' + getdynlibext();
 ENTRYLIB = 'libmaxima';
end
addinter(LIBPATHNAME,ENTRYLIB,functions)

// macOS/2027 port (Task 12): the next few lines used funptr()/intppty() --
// both very old Fortran-interface plumbing -- to flip newfun-registered
// primitives (maxadd/maxpow/... below) to pass-by-reference. funptr('sin')
// no longer returns a plain comparable number in this build ("Undefined
// operation for the given operands" on the '<' below), and intppty() itself
// is not meant to be called on this build's primitives at all -- guarded
// out entirely rather than guessed at; the op-overload smoke (x^2 below,
// via newfun) passing means this was not actually load-bearing here.
//La ligne suivante permet que le passage des parametres se fasse par reference
//plutot que par valeur
//if funptr('sin') < 1000 then
//  intppty(floor(funptr('maxinit')/100));
//else
//  intppty(floor(funptr('maxinit')/1000));
//end

//Les types suivants sont geres en interne
types_geres=['c','i','p','s','sym']

//On construit les fonctions de surcharge des operateurs
//Par exemple, %sym_a_s est une copie du pointeur vers maxadd, ce mecanisme
//est preferable a la creation d'une macro car le passage des param se fera
//par reference ce qui evite une copie locale des param.
// macOS/2027 port (Task 12): 2nd column now names the literal registered
// primitive (maxevalopA..S, see `functions` above) instead of the old
// friendly alias -- each letter here is matched to its build-time slot via
// maxevalop.c's determineOp(stri[9]-65) against operateurs.h's __ADD.._AFFECT
// order (A=__ADD=0 ... S=__AFFECT=18); 'o'/'n' (eq/neq) intentionally map to
// R/Q, not O/N -- __EQ=17=R and __NEQ=16=Q, not positionally A-for-a.
op_maxfun=[['a' 'maxevalopA'];['p' 'maxevalopB'];['m' 'maxevalopC'];['r' 'maxevalopD'];['s' 'maxevalopE'];['l' 'maxevalopF'];['x' 'maxevalopG'];['d' 'maxevalopH'];['q' 'maxevalopI'];['j' 'maxevalopJ'];['v' 'maxevalopK'];['k' 'maxevalopL'];['1' 'maxevalopM'];['3' 'maxevalopN'];['2' 'maxevalopO'];['4' 'maxevalopP'];['o' 'maxevalopR'];['n' 'maxevalopQ'];['b' 'maxevalopS']]

[m,n]=size(op_maxfun)

// macOS/2027 port (Task 12): newfun(alias, existing_fn_ptr_as_int) is gone --
// modern newfun (modules/core/sci_gateway/cpp/sci_newfun.cpp) takes TWO
// STRINGS, newfun(alias_name, existing_name), and looks the existing
// function up by name via the symbol context instead of a numeric
// pointer/index (confirmed from source: the .xml help text describing a
// numeric 2nd argument is stale). op_maxfun(j,2) is already the target
// primitive's plain name (e.g. 'maxadd'), so funptr() is simply dropped.
for i=types_geres,
  for j=1:m,
    newfun('%sym_'+op_maxfun(j,1)+'_'+i, op_maxfun(j,2))
    if ((i ~= 'sym')&(op_maxfun(j,2) ~= 'maxevalopS')),
      newfun('%'+i+'_'+op_maxfun(j,1)+'_sym', op_maxfun(j,2))
    end
  end
end;

// macOS/2027 port (Task 12): macros/maxfun/genmaxfun/ is a BUILD-TIME
// generated tree (one convenience macro per known Maxima function, e.g.
// expand/factor/solve -- see macros/maxfun/buildmaxfun.sce) that is
// produced by running buildmaxfun.sce separately from the normal
// builder.sce flow, and never has been for this install. Those macros are
// pure sugar over maxevalf()/maxevalfl() (which this port's gateway
// registers unconditionally just above); load them if present, skip
// gracefully otherwise -- same reasoning for personnalizedOverload.sce,
// which calls the (equally absent) Overload Toolbox's overload() function.
if isdir(mpath+'macros/maxfun/genmaxfun/') then
  SciMax_maxfunlib=lib(mpath+'macros/maxfun/genmaxfun/')
  // Both overload scripts call overload(), which ONLY the Overload Toolbox
  // provides. That toolbox cannot run here and this is not a packaging gap:
  // its src/overstack.c drives Scilab 5's interpreter through C2F(cvname),
  // C2F(cvnamel) and C2F(createvarfromptr) — Fortran-bridge entry points into
  // the old symbol table, which Scilab 6 deleted when the interpreter was
  // rewritten around a C++ AST. Porting it means redesigning it, not rebuilding
  // it. The modern equivalent is native overloading (%<type>_<function>
  // macros), which is a separate piece of work on SciMax itself.
  //
  // So guard on the function rather than on the file. Without this guard the
  // whole SciMax load ABORTS here, and SciMax_percentlib/SciMaxlib below never
  // load — which is exactly what happened the moment genmaxfun was first built.
  if isdef('overload') then
    if fileinfo(mpath+'macros/maxfun/personnalizedOverload.sce')==[] then
      exec(mpath+'macros/maxfun/genmaxfun/overload.sce',-1)
    else
      exec(mpath+'macros/maxfun/personnalizedOverload.sce',-1)
    end
  else
    printf('SciMax: Maxima overloads of Scilab macros (cotg, eval, rank, ... on sym types) are not registered — they need the Overload Toolbox, which is Scilab-5-only. maxevalf/maxevalfl and the %d generated maxfun macros are unaffected.\n', 1363)
  end
else
  printf('macros/maxfun/genmaxfun not built; skipping the generated Maxima-function convenience macros (use maxevalf/maxevalfl directly).\n')
end
SciMax_percentlib=lib(mpath+'macros/percent/')
SciMaxlib=lib(mpath+'macros/')


//add help chapter
printf('Load help : ');
path_addchapter = mpath + "jar/";
if ( fileinfo(path_addchapter) <> [] ) then
    add_help_chapter('SciMax Toolbox', path_addchapter, %F);
    clear add_help_chapter;
end

printf('help loaded\n');

add_demo('SciMax demo',mpath+'demos/SciMax.dem');
printf('You can see a demo with exec ""'+mpath+'demos/SciMax.dem""\n');

//La variable xml_en_tete sert a ajouter l'en-tete necessaire pour les fichiers contenant du mathml 
xml_en_tete=['<?xml version=""1.0"" encoding=""UTF-8""?>';'<!DOCTYPE math PUBLIC ""-//W3C//DTD MathML 2.0//EN"" ""http://www.w3.org/Math/DTD/mathml2/mathml2.dtd"">'];

printf('\n** Use maxinit to start Maxima  **\n')

clear mpath Overload_TB_path functions types_geres op_maxfun m n f err





